CREATE TABLE exerciseEntity (
    id TEXT PRIMARY KEY NOT NULL,
    user_id TEXT NOT NULL,
    name TEXT NOT NULL,
    muscle_group TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE sessionEntity (
    id TEXT PRIMARY KEY NOT NULL,
    exercise_id TEXT NOT NULL,
    date_created TEXT,
    is_pending INTEGER NOT NULL DEFAULT 0,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(exercise_id) REFERENCES exerciseEntity(id) ON DELETE CASCADE
);

CREATE TABLE setEntity (
    id TEXT PRIMARY KEY NOT NULL,
    session_id TEXT NOT NULL,
    weight REAL NOT NULL,
    reps INTEGER NOT NULL,
    date_created TEXT,
    is_pending INTEGER NOT NULL DEFAULT 0,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(session_id) REFERENCES sessionEntity(id) ON DELETE CASCADE
);

CREATE TABLE userRoutineEntity (
    user_id TEXT PRIMARY KEY NOT NULL,
    routine_data TEXT NOT NULL
);

-- Exercises
insertOrReplaceExercise:
INSERT OR REPLACE INTO exerciseEntity(id, user_id, name, muscle_group, is_deleted)
VALUES (?, ?, ?, ?, ?);

getExercisesByUserId:
SELECT * FROM exerciseEntity WHERE user_id = ? AND is_deleted = 0;

markExerciseAsDeleted:
UPDATE exerciseEntity SET is_deleted = 1 WHERE id = ?;

getPendingDeletedExercisesByUserId:
SELECT id FROM exerciseEntity WHERE user_id = ? AND is_deleted = 1;

deleteExerciseById:
DELETE FROM exerciseEntity WHERE id = ?;

deleteExercisesByUserId:
DELETE FROM exerciseEntity WHERE user_id = ?;

-- Sessions
insertOrReplaceSession:
INSERT OR REPLACE INTO sessionEntity(id, exercise_id, date_created, is_pending, is_deleted)
VALUES (?, ?, ?, ?, ?);

getSessionsByExerciseId:
SELECT * FROM sessionEntity WHERE exercise_id = ? AND is_deleted = 0;

getPendingSessionsByUserId:
SELECT sessionEntity.*
FROM sessionEntity
INNER JOIN exerciseEntity ON sessionEntity.exercise_id = exerciseEntity.id
WHERE exerciseEntity.user_id = ? AND sessionEntity.is_pending = 1 AND sessionEntity.is_deleted = 0;

markSessionSynced:
UPDATE sessionEntity SET is_pending = 0 WHERE id = ?;

markSessionAsDeleted:
UPDATE sessionEntity SET is_deleted = 1 WHERE id = ?;

getPendingDeletedSessionsByUserId:
SELECT sessionEntity.id
FROM sessionEntity
INNER JOIN exerciseEntity ON sessionEntity.exercise_id = exerciseEntity.id
WHERE exerciseEntity.user_id = ? AND sessionEntity.is_deleted = 1;

deleteSessionById:
DELETE FROM sessionEntity WHERE id = ?;

deleteAllSessions:
DELETE FROM sessionEntity;

-- Sets
insertOrReplaceSet:
INSERT OR REPLACE INTO setEntity(id, session_id, weight, reps, date_created, is_pending, is_deleted)
VALUES (?, ?, ?, ?, ?, ?, ?);

getSetsBySessionId:
SELECT * FROM setEntity WHERE session_id = ? AND is_deleted = 0;

getPendingSetsByUserId:
SELECT setEntity.*
FROM setEntity
INNER JOIN sessionEntity ON setEntity.session_id = sessionEntity.id
INNER JOIN exerciseEntity ON sessionEntity.exercise_id = exerciseEntity.id
WHERE exerciseEntity.user_id = ? AND setEntity.is_pending = 1 AND sessionEntity.is_pending = 0 AND setEntity.is_deleted = 0;

markSetSynced:
UPDATE setEntity SET is_pending = 0 WHERE id = ?;

markSetAsDeleted:
UPDATE setEntity SET is_deleted = 1 WHERE id = ?;

getPendingDeletedSetsByUserId:
SELECT setEntity.id
FROM setEntity
INNER JOIN sessionEntity ON setEntity.session_id = sessionEntity.id
INNER JOIN exerciseEntity ON sessionEntity.exercise_id = exerciseEntity.id
WHERE exerciseEntity.user_id = ? AND setEntity.is_deleted = 1;

deleteSetById:
DELETE FROM setEntity WHERE id = ?;

deleteAllSets:
DELETE FROM setEntity;

-- User Routines
insertOrReplaceUserRoutine:
INSERT OR REPLACE INTO userRoutineEntity(user_id, routine_data)
VALUES (?, ?);

getUserRoutine:
SELECT * FROM userRoutineEntity WHERE user_id = ?;

deleteUserRoutine:
DELETE FROM userRoutineEntity WHERE user_id = ?;
